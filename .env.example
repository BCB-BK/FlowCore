# Database
DATABASE_URL=postgresql://user:password@localhost:5432/flowcore

# API Server
LOG_LEVEL=info
# PORT ist die vom API-Server gelesene Pflicht-Variable (API_PORT wird nur noch
# vom Vite-Dev-Proxy als Fallback verstanden)
PORT=8080
SESSION_SECRET=change-me-to-a-random-string

# Microsoft Entra ID (SSO)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=
# Optional: restrict login to members of this Entra group (BildungsCampus - Übergreifend).
# Leave empty to allow all users in the tenant.
ENTRA_REQUIRED_GROUP_ID=
# Delegierte Graph-Berechtigungen beim Login (kommagetrennt).
# Ohne Sites.Read.All trägt das Benutzertoken keine SharePoint-Rechte.
ENTRA_SCOPES=openid,profile,email,User.Read,Sites.Read.All

# Microsoft Teams
TEAMS_APP_ID=
# Teams-App-ID für das Frontend (Vite; zur Build-Zeit eingebettet)
VITE_TEAMS_APP_ID=

# Microsoft Graph Connector (Copilot-Index) — optional
GRAPH_EXTERNAL_CONNECTION_ID=
GRAPH_EXTERNAL_CONNECTION_NAME=
GRAPH_EXTERNAL_CONNECTION_DESCRIPTION=

# Auth
AUTH_DEV_MODE=true

# AI / OpenAI
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# App
APP_PUBLIC_URL=
